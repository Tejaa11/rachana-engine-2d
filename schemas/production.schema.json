{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Tejaa11/rachana-engine-2d/schemas/production.schema.json",
  "title": "Rachana production brief v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "script",
    "audio",
    "timing"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 80
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 90
    },
    "script": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?![A-Za-z][A-Za-z0-9+.-]*:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000-\\u001F\\u007F]+$"
    },
    "audio": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?![A-Za-z][A-Za-z0-9+.-]*:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000-\\u001F\\u007F]+$"
    },
    "timing": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?![A-Za-z][A-Za-z0-9+.-]*:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000-\\u001F\\u007F]+$"
    },
    "style": {
      "enum": [
        "paper",
        "ocean",
        "midnight"
      ]
    },
    "beats": {
      "type": "array",
      "minItems": 2,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fromWord",
          "toWord",
          "heading"
        ],
        "properties": {
          "fromWord": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "toWord": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "heading": {
            "type": "string",
            "minLength": 1,
            "maxLength": 110
          },
          "template": {
            "enum": [
              "opening",
              "focus",
              "cards",
              "process",
              "compare",
              "closing"
            ]
          },
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 3,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 70
            }
          },
          "subject": {
            "enum": [
              "idea",
              "book",
              "leaf",
              "board",
              "shield"
            ]
          }
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "fps"
      ],
      "properties": {
        "width": {
          "enum": [
            1280,
            1920
          ]
        },
        "height": {
          "enum": [
            720,
            1080
          ]
        },
        "fps": {
          "enum": [
            24,
            30,
            60
          ]
        }
      }
    }
  }
}
