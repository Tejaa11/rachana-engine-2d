{
  "name": "rachana-engine-2d",
  "version": "0.1.0-alpha.2",
  "private": true,
  "description": "An early 2D scene runtime with a local render CLI and narration-anchored animation.",
  "type": "module",
  "license": "MIT",
  "author": "Tejas Dadhich (https://github.com/Tejaa11)",
  "repository": {
    "type": "git",
    "url": "https://github.com/Tejaa11/rachana-engine-2d.git"
  },
  "bugs": {
    "url": "https://github.com/Tejaa11/rachana-engine-2d/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "node tools/check-repository.mjs",
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs",
    "cli": "node dist/apps/cli/src/main.js",
    "doctor": "node dist/apps/cli/src/main.js doctor",
    "render:smoke": "node dist/apps/cli/src/main.js render examples/minimal-scene/scene.json --out renders/minimal.mp4",
    "render:demo": "node dist/apps/cli/src/main.js render examples/narrated-story/scene.json --out renders/rachana-demo.mp4",
    "verify:smoke": "node tools/verify-smoke.mjs renders/minimal.mp4",
    "showcase": "node tools/build-showcase.mjs",
    "creative:prepare": "npm run build && node tools/build-creative-audio.mjs && node tools/build-creative-story.mjs",
    "render:creative": "node dist/apps/cli/src/main.js render examples/narrated-story/creative.scene.json --out renders/rachana-creative.mp4"
  },
  "dependencies": {
    "@napi-rs/canvas": "1.1.1",
    "ajv": "8.20.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ]
}
